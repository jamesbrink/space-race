#!/bin/sh
# The commit message (AGENTS.md): Conventional Commits, and no attribution of the work to an AI.
[ "${SKIP_HOOKS:-}" = 1 ] && exit 0
msg_file="$1"
first=$(head -n1 "$msg_file")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) ;;
  *)
    if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|wip)(\([a-z0-9._/-]+\))?!?: .+'; then
      echo "commit-msg: not a Conventional Commit: \"$first\"" >&2
      echo "  type(scope): subject, type one of feat fix docs style refactor perf test build ci chore revert wip" >&2
      exit 1
    fi
    ;;
esac
if grep -Eiq '^co-authored-by:.*(claude|anthropic|openai|codex|copilot|gpt)|generated with .*(claude|codex|copilot)' "$msg_file"; then
  echo "commit-msg: no AI attribution in commits (AGENTS.md)" >&2
  exit 1
fi
