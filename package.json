{
  "name": "space-race",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Every crewed spacecraft, modelled to scale and flown: starting with Freedom 7.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && ruff check .",
    "format": "biome format --write . && ruff format .",
    "format:check": "biome format . && ruff format --check .",
    "test": "node --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "model": "node tools/build-model.mjs",
    "models": "node tools/build-model.mjs --all",
    "collision": "node tools/collision-bake.mjs",
    "test:flight-pixels": "node tools/flight-pixels.mjs",
    "test:flicker": "node tools/flicker-test.mjs",
    "test:frozen": "node tools/frozen-test.mjs",
    "test:camera": "node tools/camera-test.mjs",
    "test:studio": "node tools/studio-test.mjs",
    "test:places": "node tools/places-test.mjs",
    "test:impact": "node tools/impact-test.mjs",
    "test:descent-attitude": "node tools/descent-attitude.mjs",
    "test:separation": "node tools/separation-test.mjs",
    "test:fires": "node tools/fires-test.mjs",
    "test:chute": "node tools/chute-test.mjs",
    "test:clouds": "node tools/clouds-test.mjs",
    "test:glow": "node tools/glow-test.mjs",
    "test:winds": "node tools/winds-test.mjs",
    "test:night": "node tools/night-test.mjs",
    "test:history": "node tools/history-test.mjs",
    "test:mem": "node tools/mem-test.mjs",
    "test:wheels": "node tools/wheels-test.mjs",
    "test:seat": "node tools/seat-test.mjs",
    "test:crew-start": "node tools/crew-start-test.mjs",
    "test:walk": "node tools/walk-test.mjs",
    "test:operate": "node tools/operate-test.mjs",
    "test:sound": "node tools/sound-test.mjs",
    "test:drive": "node tools/drive-test.mjs",
    "test:front": "node tools/front-test.mjs",
    "test:lineup": "node tools/lineup-test.mjs",
    "test:soyuz-boarding": "node tools/soyuz-boarding-test.mjs",
    "test:model-eviction": "node tools/model-eviction-test.mjs",
    "test:flights": "node tools/flights-test.mjs",
    "test:docking": "node tools/docking.mjs",
    "test:deck": "node tools/deck-test.mjs",
    "test:path": "node tools/path-test.mjs",
    "test:sheet": "node tools/sheet-test.mjs",
    "bench": "node tools/bench.mjs",
    "figures": "node tools/figures.mjs",
    "globe": "node tools/globe.mjs",
    "globe:region": "node tools/globe-region.mjs",
    "globe:surface": "node tools/globe-surface.mjs",
    "ephemeris": "node tools/ephemeris-bake.mjs",
    "ut1": "node tools/ut1-bake.mjs",
    "stars": "node tools/stars.mjs",
    "front:earth": "node tools/front-earth.mjs",
    "front:moon": "node tools/front-moon.mjs",
    "globe:weather": "node tools/globe-weather.mjs",
    "era5:aloft": "node tools/era5-aloft.mjs",
    "rust:models:build": "node rust/tools/build-models.mjs",
    "rust:models": "node rust/tools/unpack-models.mjs",
    "rust:run": "cd rust && cargo run --release -p space-race --",
    "rust:check": "cd rust && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "rust:fmt": "cd rust && cargo fmt --all"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "three": "^0.187.0",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
