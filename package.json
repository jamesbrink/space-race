{
  "name": "space-race",
  "version": "0.1.0",
  "private": true,
  "description": "Every crewed spacecraft, modelled to scale and flown: starting with Freedom 7.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && ruff check .",
    "format": "biome format --write . && ruff format .",
    "format:check": "biome format . && ruff format --check .",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "models": "node tools/build-model.mjs --all",
    "test:flicker": "node tools/flicker-test.mjs",
    "test:frozen": "node tools/frozen-test.mjs",
    "test:camera": "node tools/camera-test.mjs",
    "test:places": "node tools/places-test.mjs",
    "test:mem": "node tools/mem-test.mjs",
    "test:front": "node tools/front-test.mjs",
    "bench": "node tools/bench.mjs",
    "globe": "node tools/globe.mjs",
    "globe:region": "node tools/globe-region.mjs missions/usa/mercury/sites/lc-5.ts",
    "globe:surface": "node tools/globe-surface.mjs",
    "stars": "node tools/stars.mjs",
    "front:earth": "node tools/front-earth.mjs",
    "front:moon": "node tools/front-moon.mjs",
    "globe:weather": "node tools/globe-weather.mjs missions/usa/mercury/sites/lc-5.ts",
    "model:mr-3": "node tools/build-model.mjs usa/mercury/mr-3-freedom-7",
    "model:mr-4": "node tools/build-model.mjs usa/mercury/mr-4-liberty-bell-7",
    "model:ma-6": "node tools/build-model.mjs usa/mercury/ma-6-friendship-7",
    "model:vostok-1": "node tools/build-model.mjs ussr/vostok/vostok-1",
    "model:vostok-2": "node tools/build-model.mjs ussr/vostok/vostok-2",
    "model:lc-5": "node tools/build-model.mjs usa/mercury/sites/lc5",
    "model:site-1": "node tools/build-model.mjs ussr/vostok/sites/site1",
    "model:cape": "node tools/build-model.mjs usa/mercury/sites/cape"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "three": "^0.187.0",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
